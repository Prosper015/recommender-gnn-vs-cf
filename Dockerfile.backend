FROM python:3.10-slim

WORKDIR /app

# Installer les dépendances système nécessaires pour la compilation de certains packages Python
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Copier et installer les dépendances Python
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copier le code source et les artefacts
COPY src/ ./src/
COPY models/ ./models/
COPY data/ ./data/

# Exposer le port de l'API
EXPOSE 8000

# Lancer Uvicorn en mode reload pour le développement
CMD ["uvicorn", "src.api.main:app", "--reload", "--host", "0.0.0.0", "--port", "8000"]
